# Django Settings Module
DJANGO_SETTINGS_MODULE=bmi_monitor.settings

# Security: Generate a strong secret key for production
SECRET_KEY=your-super-secret-key-here

# Environment
DEBUG=False

# Database URL (format: postgres://user:password@host:port/dbname)
# For local dev, leave empty to use SQLite
DATABASE_URL=

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS allowed origins (comma-separated)
# For Render frontend: https://yourfrontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
